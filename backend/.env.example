# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=luers_db
DB_USER=luers_user
DB_PASSWORD=luers_password
DB_HOST=localhost
DB_PORT=5432

# Redis (for Channels + Celery)
REDIS_URL=redis://localhost:6379/0

# Celery Broker URL (same as Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Media / File uploads
MEDIA_ROOT=media/

# CORS — production.py rejects all origins unless explicitly listed here
CORS_ALLOWED_ORIGINS=http://localhost:5175

# Where password-reset emails (and similar outbound links) should point
FRONTEND_URL=http://localhost:5175

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (Mailtrap sandbox in dev; swap for a real SMTP provider in prod)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=2525
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LUERS <noreply@luers.com>