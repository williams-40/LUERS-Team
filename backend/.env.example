# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=luers_db
DB_USER=luers_user
DB_PASSWORD=luers_password
DB_HOST=localhost
DB_PORT=5432

# Redis (for Channels + Celery)
REDIS_URL=redis://localhost:6379/0

# Celery Broker URL (same as Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Media / File uploads
MEDIA_ROOT=media/

# Identity escrow encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=replace-with-generated-fernet-key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
IDENTITY_HASH_KEY=replace-with-generated-hmac-key